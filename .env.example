# Local development configuration. Copy to .env and replace the values.
APP_ENV=development
SECRET_KEY=replace_with_a_random_secret_at_least_32_characters
JWT_SECRET_KEY=replace_with_a_different_random_secret_at_least_32_characters

DB_HOST=localhost
DB_PORT=3306
DB_NAME=tuition_management
DB_USER=root
DB_PASSWORD=replace_with_your_mysql_password

CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Optional: enables Gemini-written institute report summaries and the AI assistant.
# If unset or unavailable, institute reports use the built-in factual summary.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
